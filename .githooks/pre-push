#!/bin/sh
# push-gate pre-push hook (see ~/.agents/skills/push-gate/SKILL.md)
# git passes the remote name and url as arguments (ignored) and one
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" line per pushed
# ref on stdin; deleted refs (all-zero local sha) have nothing to audit.
# A brand-new remote ref is audited from the empty tree (full history).
GATE="$HOME/.agents/skills/push-gate/scripts/pre_push_audit.py"
REPO_ROOT="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        ''|*[!0]*) ;;
        *) continue ;;
    esac
    python3 "$GATE" --repo-root "$REPO_ROOT" \
        --range "$remote_sha..$local_sha" || status=1
done
exit "$status"
